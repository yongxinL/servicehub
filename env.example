# -----------------------------------------------------------------------------
# serviceHub Environment Variables
#
# This file serves as a template for the required environment variables.
# Copy this file to .env and fill in the values for your specific environment.
# The .env file is ignored by Git to keep your secrets safe.
#
# Variable prefixes map to the compose domain that consumes them (ADR-008):
#   TRAEFIK_*                       -> compose/route.yml
#   DB_* / MARIADB_* / POSTGRES_*   -> compose/infra.yml
#   IDENTITY_*                      -> compose/infra.yml
#   SOURCECODE_*                    -> compose/devops.yml
#   WORKSPACE_* / CLOUD_*           -> compose/webapp.yml
#   WEBAPP_CONF_*                   -> webappconf build arguments
#   CHAT_*                          -> compose/aiserv.yml
#   LLAMA_* / AIGATE_* / HERMES_*   -> compose/aiserv.yml
#   FCRW_*                          -> optional FastCRW stack (shared/fastcrw/compose.yml)
#   OBSERVABILITY_*                 -> compose/obsvce.yml (OCI scope per ADR-010;
#                                      CI deployment integration is deferred to
#                                      Phase 5 and remains a manual deployment
#                                      prerequisite until approved)
#   EMAIL_*                         -> SMTP clients (Authentik, Forgejo);
#                                      also compose/mailsv.yml when enabled
#   STALWART_* / POSTOFFICE_* / WEBMAIL_* -> compose/mailsv.yml (disabled by default)
#   ENABLE_MAILSV                       -> scripts/gen-admin-rules.py (set "true" to enable)
#   EGRESS_*                        -> scripts/firewall.sh (host systemd,
#                                      not consumed by Compose — see
#                                      docs/operations/EGRESS-CONTROLS.md)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# --> System & General Settings

# Deployment label used by observability telemetry. Use `stag` or `prod` on OCI;
# leave `unknown` only for disposable local test runs.
ENVIRONMENT="unknown"

# Your local timezone (e.g., "Australia/Sydney", "America/New_York")
TIME_ZONE="Australia/Sydney"

# Base path on the host machine where application data will be stored
APPS_DATA="~/Documents/containerd"

# -----------------------------------------------------------------------------
# --> Domain & Network Settings

# Your primary domain name. The derived hosts below reference it
# (${DOMAIN_NAME}), so after changing it re-run scripts/setup.sh: it re-merges
# the .env and regenerates shared/traefik/advanced/admin-routers.yml, whose
# Host rules follow TRAEFIK_DOMAIN/EMAIL_HOST/IDENTITY_DOMAIN. Keep those keys
# in the "${...}.${DOMAIN_NAME}" form — a literal value (traefik.example.com)
# does not move when DOMAIN_NAME changes.
DOMAIN_NAME="example.local"

# trusted IPs — forwarded-header trust plus the allow list for administrative
# endpoints (Traefik dashboard, mail admin). ADR-009: the admin ClientIP rules
# and allow lists are GENERATED from this value into
# shared/traefik/advanced/admin-routers.yml by scripts/setup.sh. After changing
# it, re-run scripts/setup.sh (or scripts/gen-admin-rules.py) — Traefik
# hot-reloads, no container restart. The entrypoint forwardedHeaders.trustedIPs
# flag is static and only refreshes on the next routetraefik recreate.
TRUSTED_IP="127.0.0.0/8, ::1/128, 172.18.0.0/16"

# Container Egress Controls (scripts/firewall.sh — host systemd, not Compose)
# CIDR feed(s) behind the global block: one or more whitespace-separated URLs,
# each returning JSON with an "items" array of {"cidr": "<prefix>"}. All CIDRs
# merge into one ipset; every feed must fetch or the existing set is kept.
# Read by `blocked-refresh` and `watch` from this file (an exported
# EGRESS_BLOCK_URL overrides it).
# PLACEHOLDER — replace with your real feed before enabling the block; an
# unreachable or non-JSON feed fails safe (existing ipset kept, layer 1
# `restricted` still active, warning printed).
EGRESS_BLOCK_URL="https://ip-ranges.example.com/"

# -----------------------------------------------------------------------------
# --> Outbound SMTP Variables (Authentik, Forgejo; compose/mailsv.yml when enabled)
# Configure these for the external email provider. If ENABLE_MAILSV="true",
# EMAIL_HOST must also be the public Stalwart hostname.
ENABLE_MAILSV="false"

EMAIL_HOST="smtp.${DOMAIN_NAME}"

# Prefer implicit-TLS submission on port 465. Use 587 only when the provider
# requires STARTTLS.
EMAIL_PORT="465"
EMAIL_USER="servicehub@${DOMAIN_NAME}"
EMAIL_PASS="<YOUR_EMAIL_PASSWORD>"
EMAIL_FROM="ServiceHub <servicehub@${DOMAIN_NAME}>"

# OCI Email Delivery example (requires an approved sender and SMTP credentials):
# EMAIL_HOST="smtp.email.<region>.oci.oraclecloud.com"
# EMAIL_PORT="587"
# EMAIL_USER="<OCI_SMTP_CREDENTIAL_USERNAME>"
# EMAIL_PASS="<OCI_SMTP_CREDENTIAL_PASSWORD>"
# EMAIL_FROM="<APPROVED_SENDER@${DOMAIN_NAME}>"
# Port 587 uses STARTTLS; see README — OCI Email Delivery for the matching
# Authentik and Forgejo settings.

# Self-hosted mail-only variables (disabled by default; OCI blocks port 25).
# They stay configured so enabling later requires only the flag and Compose
# include. setup.sh generates both secrets. On an existing PostgreSQL cluster,
# create POSTOFFICE_DBNAME manually because database bootstrap runs only once.
# Public hostname of the webmail client (Bulwark)
POSTOFFICE_DOMAIN="outlook.${DOMAIN_NAME}"

# Stalwart is reachable at ${EMAIL_HOST}; it must differ from POSTOFFICE_DOMAIN because
# Traefik routes one hostname per router
# PostgreSQL database holding Stalwart mail data (accounts, messages, blobs).
# New installations: POSTGRES_DATABASES includes this database. Existing
# installations: create it manually before enabling mailsv.
POSTOFFICE_DBNAME="svchub_postoffice"

# Stalwart fallback administrator (mapped to Stalwart's STALWART_RECOVERY_ADMIN).
# The entrypoint renders a data-store config on every start, so Stalwart never
# enters bootstrap mode and prints no temporary password. This account is the way
# in at https://${EMAIL_HOST}/admin, and it keeps working even if the provisioned
# admin account or the configured directory breaks. setup.sh auto-generates the
# password; leave STALWART_ADMIN_PASS empty to disable the fallback.
STALWART_ADMIN_USER="admin"
STALWART_ADMIN_PASS="<YOUR_STRONG_STALWART_ADMIN_PASSWORD>"

# Session cookie encryption for Bulwark (openssl rand -base64 32; auto-generated by setup.sh)
WEBMAIL_SESSION_SECRET="<YOUR_STRONG_WEBMAIL_SESSION_SECRET>"

# -----------------------------------------------------------------------------
# --> Route / TLS (compose/route.yml -> routetraefik)

TRAEFIK_DOMAIN="traefik.${DOMAIN_NAME}"
TRAEFIK_ACMEMAIL="youremail@${DOMAIN_NAME}"

# HTTP Basic Auth for Traefik dashboard (htpasswd format: user:$apr1$...)
# Generate with: echo $(htpasswd -nb user "password") | sed -e 's/\$/\\$/g'
# Review the result to ensure a backslash (\) precedes each dollar sign ($).
TRAEFIK_BAAUTH=""

# TLS certificate resolver: "letsencrypt" for Let's Encrypt, empty for self-signed
CERTRESOLVER=letsencrypt

# -----------------------------------------------------------------------------
# --> Identity / SSO (compose/infra.yml -> infraauth, infraauthwrk)

IDENTITY_DOMAIN="login.${DOMAIN_NAME}"
IDENTITY_TAG="2026.8"
IDENTITY_PASSWORD="<YOUR_STRONG_AUTHENTIK_PASSWORD>"
IDENTITY_SECRET="<YOUR_STRONG_AUTHENTIK_SECRETKEY>"
IDENTITY_DBNAME="svchub_identity"

# -----------------------------------------------------------------------------
# --> DevOps: source control + CI (compose/devops.yml)

SOURCECODE_DOMAIN="git.${DOMAIN_NAME}"

# Forgejo (self-hosted git) — service: devopsforgejo
SOURCECODE_DBNAME="svchub_sourcecode"
SOURCECODE_TAG="16"

# Forgejo Actions runner (devopsrunner) — host mode: workflow jobs run in the
# runner container and deploy to remote Docker hosts over SSH.
# Shared runner secret (openssl rand -hex 20): register it once on the Forgejo
# side (see docs/operations/services/forgejo.md) and the runner uses it on first boot.
SOURCECODE_RUNNER_SECRET="<YOUR_SOURCECODE_RUNNER_SECRET>"

# Forgejo runner image tag (shared/forgejo/actions/Dockerfile IMAGE_TAG)
SOURCECODE_RUNNER_TAG="13"

# -----------------------------------------------------------------------------
# --> Web Applications (compose/webapp.yml)

# Homepage hostname served through Traefik; the apex ${DOMAIN_NAME} is served as well
WORKSPACE_DOMAIN="www.${DOMAIN_NAME}"

# Workspace database name (default: svchub_workspace)
WORKSPACE_DBNAME="svchub_workspace"
WORKSPACE_TAG="10.2"

# Confluence Marketplace plugins installed during the webappconf image build.
# Plugin-file=url entries, one per line. Add or remove entries as needed.
WEBAPP_CONF_PLUGINS="com.resolution.atlasplugins.samlsso.Confluence.jar=https://marketplace.atlassian.com/download/app/com.resolution.atlasplugins.samlsso.Confluence/202608271001/DATACENTER/artifact
com.stiltsoft.confluence.plugin.tablefilter.tablefilter.jar=https://marketplace.atlassian.com/download/app/com.stiltsoft.confluence.plugin.tablefilter.tablefilter/53107670/DATACENTER/artifact
com.atlassian.confluence.plugins.confluence-questions.jar=https://marketplace.atlassian.com/download/app/com.atlassian.confluence.plugins.confluence-questions/1088000102/DATACENTER/artifact"

# ownCloud Infinite Scale (oCIS) cloud drive — service: webappocis
CLOUD_DOMAIN="drive.${DOMAIN_NAME}"
CLOUD_TAG="8.2.0"

# Authentik OIDC issuer for the application slug configured below.
CLOUD_OIDC_ISSUER="https://${IDENTITY_DOMAIN}/application/o/ocis/"

# Public OAuth2/OIDC client ID shown by the Authentik provider.
CLOUD_OIDC_CLIENT_ID="<AUTHENTIK_DRIVE_CLIENT_ID>"

# Set true only when Authentik is served with a self-signed certificate.
CLOUD_INSECURE="false"

# -----------------------------------------------------------------------------
# --> AI Agent Platform (compose/aiserv.yml -> aiservhermes, aiservlitellm, aiservllamacpp)

# Open WebUI — AI platform chat interface served by aiservowui in compose/aiserv.yml
CHAT_DOMAIN="chats.${DOMAIN_NAME}"

# Hermes Agent — Traefik domain for HTTPS access (optional)
# Leave empty to use IP:port access, set domain for automatic HTTPS via Traefik
HERMES_WORKSPACE_DOMAIN_00="space0.${DOMAIN_NAME}"

# Hermes Workspace — web UI password for the agent
# Used for login at http://<host>:12320 (aiservhermes)
HERMES_WORKSPACE_PASSWD_00="<YOUR_HERMES_WORKSPACE_PASSWORD_00>"

# Hermes Agent — data directory (optional)
# Default shown — customize to change data storage location
HERMES_DATA_00="${APPS_DATA}/aiserv/hermes/00"

# LLM Inference Services (llama.cpp — CPU-only, 32 GB RAM optimised)
# Model auto-downloaded via -hf flag and cached in ${APPS_DATA}/aiserv/llamacpp
# Format: <hf-repo>:<quant>  e.g. "unsloth/gemma-4-E4B-it-GGUF:Q4_K_M"
LLAMA_CHTMDL="unsloth/gemma-4-E4B-it-GGUF:Q4_K_M"

# llama.cpp server flags (see https://github.com/ggerganov/llama.cpp/blob/master/examples/server/README.md)
# --ctx-size: context window size (65536 = 64K tokens)
# --threads / --threads-batch: CPU thread counts for inference and batch processing
# --flash-attn: enable flash attention (on/off)
# --cache-type-k / --cache-type-v: KV cache quantization types
# --temp: sampling temperature (0.0 = deterministic)
# --parallel: max concurrent inference requests
# --no-mmap --mlock: disable memory mapping, use RAM instead (safer for swapped environments)
# --cont-batching: enable continuous batching for better throughput
LLAMA_CHTARG="--ctx-size 65536 --threads 10 --threads-batch 12 --flash-attn on --cache-type-k q4_0 --cache-type-v q4_0 --temp 0.0 --parallel 4 --no-mmap --mlock --cont-batching --ubatch-size 1024"

# HuggingFace token — required only for gated models (e.g. Gemma). Leave empty
# for public models. Passed to aiservllamacpp so llama-server can authenticate.
HF_TOKEN=""

# LiteLLM Proxy — unified API gateway routing requests across local and cloud LLM providers
# Master API key — used as Bearer token by Hermes and other services to authenticate with the proxy (format: sk-...)
AIGATE_API_KEY="<YOUR_LITELLM_MASTER_API_KEY>"

# Base URL Hermes Agent (and any other in-stack client) uses to reach the LiteLLM proxy.
# Default points at the in-network aiservlitellm service; override to point at an external
# LiteLLM deployment (e.g. https://litellm.example.com/v1) if you are not running it locally.
AIGATE_API_URL="http://aiservlitellm:12380/v1"

# Admin UI credentials for the LiteLLM web dashboard (http://<host>:12380/ui)
AIGATE_ADMIN_USER="admin"
AIGATE_ADMIN_PASSWORD="<YOUR_STRONG_LITELLM_ADMIN_PASSWORD>"
AIGATE_DBNAME="svchub_aigateway"

# Hephaestus — local llama.cpp edge inference (or remote edge service)
# API key is "none" for local llama.cpp, use actual key if using a remote edge service
AIGATE_HERMES_API_URL="http://aiservllamacpp:12386/v1"
AIGATE_HERMES_API_KEY="none"

# Health check for auto-failover routing (used by smartrouter.py)
AIGATE_HERMES_HEALTH_URL="http://aiservllamacpp:12386/health"

# Prometheus — MiniMax cloud LLM provider (Anthropic-compatible API, cloud fallback)
AIGATE_PROVIDER_API_BASE="https://api.minimax.io/anthropic"
AIGATE_PROVIDER_API_KEY="<your-minimax-api-key>"

# FastCRW (Firecrawl-compatible) — optional self-hosted web scraping + search service.
# Not part of the default stack: enable the FastCRW stack by including
# shared/searxng/compose.yml, shared/fastcrw/lightpanda/compose.yml,
# shared/fastcrw/chromium/compose.yml and shared/fastcrw/compose.yml in
# docker-compose.yml. Hermes' web-search tool loop is disabled until then.
# Base URL Hermes Agent uses for web.base_url and the FastCRW client.
# Default points at the in-network aiservfastcrw service; override to point at
# an external Firecrawl-compatible deployment if you are not running locally.
FCRW_API_URL="http://aiservfastcrw:12360"

# -----------------------------------------------------------------------------
# --> Observability Stack Variables (compose/obsvce.yml: VictoriaMetrics + VictoriaLogs + Grafana)

# Grafana - Observability dashboards (public-facing, needs domain)
# Used by compose/obsvce.yml, which is in OCI scope per ADR-010. Repository
# implementation is not runtime verified until Phase 5.
OBSERVABILITY_DOMAIN="stats.${DOMAIN_NAME}"

# Grafana - Observability dashboards
OBSERVABILITY_ADMIN_USER="admin"
OBSERVABILITY_ADMIN_PASSWORD="<YOUR_STRONG_GRAFANA_PASSWORD>"

# PostgreSQL least-privilege metrics role used by Alloy's embedded exporter.
# Set the values on the OCI host; never place the password value in Git.
POSTGRES_EXPORTER_ENABLED="false"
POSTGRES_EXPORTER_HOST="infrapgsql"
POSTGRES_EXPORTER_PORT=5432
POSTGRES_EXPORTER_DATABASE="postgres"
POSTGRES_EXPORTER_USER="svc_metrics"
POSTGRES_EXPORTER_PASSWORD="<POSTGRES_METRICS_ROLE_PASSWORD>"

# OCI APM (optional, Oracle Cloud Infrastructure Application Performance
# Monitoring). Disabled by default and inert: while OCI_APM_ENABLED is false
# no exporter component is created, no DNS lookup is made, and no connection,
# trace, metric, or log is sent to OCI APM.
#
# Logs are permanently disabled for OCI APM in this project. Setting
# OCI_APM_LOGS_ENABLED=true is rejected at Alloy preflight and must stay false.
#
# To enable later, set the endpoint and data key in the server-side .env only
# (never in Git), then set OCI_APM_ENABLED=true. Traces are the only
# intended future signal; metrics stay on VictoriaMetrics and logs on
# VictoriaLogs.
#
# Prerequisite: no ServiceHub application currently emits OTLP traces, so
# traces cannot be validated until application instrumentation exists.
OCI_APM_ENABLED="false"
OCI_APM_TRACES_ENABLED="false"
OCI_APM_METRICS_ENABLED="false"
OCI_APM_LOGS_ENABLED="false"
OCI_APM_OTLP_ENDPOINT=""
OCI_APM_DATA_KEY=""

# -----------------------------------------------------------------------------
# --> Database Service Variables (compose/infra.yml)

# DB common variables
# Credentials used by the MariaDB and PostgreSQL containers on first startup to create the superuser.
DB_ADMIN_USER="dbservice"
DB_ADMIN_PASSWORD="<YOUR_STRONG_DB_ADMIN_PASSWORD>"

# MariaDB / MySQL (inframariadb)
MARIADB_HOST="inframariadb"
MARIADB_PORT=3306

# Comma-separated MariaDB databases to initialize (default: ${WORKSPACE_DBNAME}).
# MariaDB is not used by the default stack.
MARIADB_DATABASES="${WORKSPACE_DBNAME}"

# PostgreSQL (infrapgsql)
POSTGRES_HOST="infrapgsql"
POSTGRES_PORT=5432

# Comma-separated list of databases to create: "db1,db2"
POSTGRES_DATABASES="${IDENTITY_DBNAME},${SOURCECODE_DBNAME},${AIGATE_DBNAME},${WORKSPACE_DBNAME},${POSTOFFICE_DBNAME}"
