# =============================================================================
# Hermes Agent — per-container .env
#
# This file is seeded into /opt/data/.env on first container start.
# Container-level values (LITELLM_API_KEY, LITELLM_API_URL, etc.) are injected
# by compose/agent.yml from the root ServiceHub .env.
# This file documents the template values that get substituted at startup.
# =============================================================================

# LiteLLM proxy-base URL and master key.
# Substituted at container start from LITELLM_API_URL and LITELLM_API_KEY
# env vars (sourced from LITEM_API_URL and LITEM_API_KEY in root .env).
LITELLM_API_URL=<your-litellm-api-base>
LITELLM_API_KEY=<your-litellm-master-key>

# FastCRW (Firecrawl-compatible) self-hosted endpoint and auth key.
# Substituted at container start from FIRECRAWL_API_URL and FIRECRAWL_API_KEY
# env vars (sourced from FCRW_API_URL and LITEM_API_KEY in root .env).
FIRECRAWL_API_URL=<your-firecrawl-api-url>
FIRECRAWL_API_KEY=<your-firecrawl-api-key>

# =============================================================================
# Per-container configuration (set in root .env, passed to container)
# =============================================================================
# HERMES_WORKSPACE_PASSWORD  — set via HERMES_WORKSPACE_PASSWD_0X in root .env
# HERMES_DATA_0X             — data directory path (e.g. /path/to/hermes/data/00)
# HERMES_WORKSPACE_DOMAIN_0X  — Traefik domain for HTTPS (optional)
# =============================================================================