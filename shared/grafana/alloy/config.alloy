// Grafana Alloy — core telemetry: host metrics, container metrics, journal and
// container logs. Probe, native-application, and PostgreSQL pipelines are added
// in the service-telemetry stage.
// Pattern: https://github.com/grafana/alloy-scenarios

// =============================================
// HOST METRICS — built-in unix/node_exporter
// procfs/sysfs/rootfs paths point to read-only host mounts. ADR-010 section 3
// restores real host filesystem and inode collection through rootfs_path.
// =============================================
prometheus.exporter.unix "host" {
	disable_collectors = ["ipvs", "btrfs", "infiniband", "xfs", "zfs"]
	procfs_path        = "/host/proc"
	sysfs_path         = "/host/sys"
	rootfs_path        = "/host/root"

	filesystem {
		fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|tmpfs|fuse.*|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|ramfs|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
		mount_points_exclude = "^/(dev|proc|run/credentials/.+|sys)($|/)"
		mount_timeout        = "5s"
	}
}

discovery.relabel "host" {
	targets = prometheus.exporter.unix.host.targets

	rule {
		target_label = "job"
		replacement  = "obstack"
	}

	rule {
		target_label = "instance"
		replacement  = constants.hostname
	}

	rule {
		target_label = "project"
		replacement  = "servicehub"
	}

	rule {
		target_label = "environment"
		replacement  = sys.env("ENVIRONMENT")
	}
}

// =============================================
// CONTAINER METRICS — built-in cAdvisor
// docker_only=true skips host-level cgroup (avoids duplication with host metrics).
// containerd_host resolves per-container identity on containerd-backed Docker
// engines; without it only the root cgroup series is published.
// =============================================
prometheus.exporter.cadvisor "containers" {
	docker_host     = "unix:///var/run/docker.sock"
	docker_only     = true
	containerd_host = "/host/root/run/containerd/containerd.sock"
}

discovery.relabel "containers" {
	targets = prometheus.exporter.cadvisor.containers.targets

	rule {
		target_label = "job"
		replacement  = "cadvisor"
	}

	rule {
		target_label = "instance"
		replacement  = constants.hostname
	}

	rule {
		target_label = "project"
		replacement  = "servicehub"
	}

	rule {
		target_label = "environment"
		replacement  = sys.env("ENVIRONMENT")
	}
}

// =============================================
// SCRAPE — host metrics
// =============================================
prometheus.scrape "host" {
	targets         = discovery.relabel.host.output
	forward_to      = [prometheus.remote_write.vm.receiver]
	scrape_interval = "30s"
	scrape_timeout  = "15s"
}

// =============================================
// SCRAPE — container metrics → VictoriaMetrics only
// =============================================
prometheus.scrape "containers" {
	targets         = discovery.relabel.containers.output
	forward_to      = [prometheus.relabel.container_labels.receiver]
	scrape_interval = "30s"
	scrape_timeout  = "15s"
}

// cAdvisor exposes every Docker label as container_label_<name>. Containers with
// many Traefik routers exceed VictoriaMetrics' 40-label limit and are dropped
// silently, so keep only the compose service label.
prometheus.relabel "container_labels" {
	forward_to = [prometheus.remote_write.vm.receiver]

	rule {
		source_labels = ["container_label_com_docker_compose_service"]
		target_label  = "compose_service"
	}

	rule {
		action = "labeldrop"
		regex  = "container_label_.*"
	}
}

// =============================================
// TRAEFIK METRICS — scrape from Traefik's Prometheus endpoint
// =============================================
prometheus.scrape "traefik" {
	targets = [{
		__address__ = "routetraefik:8080",
		job         = "traefik",
		instance    = constants.hostname,
	}]
	forward_to      = [prometheus.remote_write.vm.receiver]
	scrape_interval = "30s"
	scrape_timeout  = "15s"
}

// =============================================
// REMOTE WRITE — VictoriaMetrics
// =============================================
prometheus.remote_write "vm" {
	endpoint {
		url = "http://obsvcevm:8428/api/v1/write"
	}
}

// =============================================
// SCRAPE — Alloy self-metrics
// Covers pipeline, remote-write, scrape, and component health.
// =============================================
prometheus.scrape "alloy_self" {
	targets = [{
		__address__ = "localhost:9080",
		job         = "alloy",
		instance    = constants.hostname,
	}]
	forward_to      = [prometheus.remote_write.vm.receiver]
	scrape_interval = "30s"
	scrape_timeout  = "15s"
}

// =============================================
// LOGS — container logs via Docker socket
// relabel_rules extracts container_name from Docker metadata
// =============================================
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "logs" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container_name"
	}

	rule {
		target_label = "instance"
		replacement  = constants.hostname
	}

	rule {
		target_label = "project"
		replacement  = "servicehub"
	}

	rule {
		target_label = "environment"
		replacement  = sys.env("ENVIRONMENT")
	}
}

// =============================================
// SELECTIVE HOST JOURNAL
// Journald match filters limit collection to SSH, sudo, logind, kernel,
// Docker, systemd, and firewall events. PIDs, usernames, paths, commands,
// and message text remain journal fields, not Prometheus metric labels.
// Journal group membership is a host prerequisite for these sources.
// =============================================
loki.relabel "journal" {
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "systemd_unit"
	}

	rule {
		source_labels = ["__journal__comm"]
		target_label  = "process_name"
	}

	rule {
		source_labels = ["__journal_priority"]
		target_label  = "priority"
	}

	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "priority_name"
	}

	rule {
		source_labels = ["__journal__hostname"]
		target_label  = "journal_host"
	}
}

loki.source.journal "ssh" {
	format_as_json = true
	max_age        = "24h"
	matches        = "_COMM=sshd"
	relabel_rules  = loki.relabel.journal.rules
	labels         = {
		project     = "servicehub",
		environment = sys.env("ENVIRONMENT"),
		instance    = constants.hostname,
		service     = "linux-host",
		component   = "security",
		source      = "journal",
	}
	forward_to = [loki.process.journal.receiver]
}

loki.source.journal "sudo" {
	format_as_json = true
	max_age        = "24h"
	matches        = "_COMM=sudo"
	relabel_rules  = loki.relabel.journal.rules
	labels         = {
		project     = "servicehub",
		environment = sys.env("ENVIRONMENT"),
		instance    = constants.hostname,
		service     = "linux-host",
		component   = "security",
		source      = "journal",
	}
	forward_to = [loki.process.journal.receiver]
}

loki.source.journal "authentication" {
	format_as_json = true
	max_age        = "24h"
	matches        = "_SYSTEMD_UNIT=systemd-logind.service"
	relabel_rules  = loki.relabel.journal.rules
	labels         = {
		project     = "servicehub",
		environment = sys.env("ENVIRONMENT"),
		instance    = constants.hostname,
		service     = "linux-host",
		component   = "security",
		source      = "journal",
	}
	forward_to = [loki.process.journal.receiver]
}

loki.source.journal "kernel" {
	format_as_json = true
	max_age        = "24h"
	matches        = "_TRANSPORT=kernel"
	relabel_rules  = loki.relabel.journal.rules
	labels         = {
		project     = "servicehub",
		environment = sys.env("ENVIRONMENT"),
		instance    = constants.hostname,
		service     = "linux-host",
		component   = "system",
		source      = "journal",
	}
	forward_to = [loki.process.journal.receiver]
}

loki.source.journal "docker" {
	format_as_json = true
	max_age        = "24h"
	matches        = "_SYSTEMD_UNIT=docker.service"
	relabel_rules  = loki.relabel.journal.rules
	labels         = {
		project     = "servicehub",
		environment = sys.env("ENVIRONMENT"),
		instance    = constants.hostname,
		service     = "docker",
		component   = "runtime",
		source      = "journal",
	}
	forward_to = [loki.process.journal.receiver]
}

loki.source.journal "systemd" {
	format_as_json = true
	max_age        = "24h"
	matches        = "_COMM=systemd"
	relabel_rules  = loki.relabel.journal.rules
	labels         = {
		project     = "servicehub",
		environment = sys.env("ENVIRONMENT"),
		instance    = constants.hostname,
		service     = "linux-host",
		component   = "systemd",
		source      = "journal",
	}
	forward_to = [loki.process.journal.receiver]
}

loki.source.journal "firewall" {
	format_as_json = true
	max_age        = "24h"
	matches        = "SYSLOG_IDENTIFIER=firewalld"
	relabel_rules  = loki.relabel.journal.rules
	labels         = {
		project     = "servicehub",
		environment = sys.env("ENVIRONMENT"),
		instance    = constants.hostname,
		service     = "linux-host",
		component   = "firewall",
		source      = "journal",
	}
	forward_to = [loki.process.journal.receiver]
}

loki.process "journal" {
	stage.static_labels {
		values = {
			event_source = "journald",
		}
	}

	forward_to = [loki.secretfilter.host.receiver]
}

loki.secretfilter "host" {
	drop_on_timeout = true
	label_timed_out = true
	redact_with     = "<REDACTED:$SECRET_NAME>"
	forward_to      = [loki.write.vlogs.receiver]
}

// =============================================
// GEOIP ENRICHMENT — for Traefik access logs
// =============================================
loki.process "geoip_enrichment" {
	forward_to = [loki.write.vlogs.receiver]

	// Extract client IP from Traefik JSON log ClientHost field (real TCP source address)
	stage.json {
		expressions = {
			client_ip = "ClientHost",
		}
	}
	// Keep the TCP source address in structured metadata. It is searchable for
	// investigation but is not promoted to a VictoriaLogs stream label, so
	// stream cardinality stays bounded.
	stage.structured_metadata {
		values = {
			client_ip = "",
		}
	}

	// Apply GeoIP lookup for all IPs
	// Private IPs will return empty/none values from the GeoIP database
	stage.geoip {
		source  = "client_ip"
		db      = "/geoip/GeoLite2-City.mmdb"
		db_type = "city"
	}

	// Only the bounded country code becomes a stream label; city and
	// coordinates stay searchable structured metadata (ADR-010 sections 9 and 24).
	stage.labels {
		values = {
			geoip_country_code = "",
		}
	}

	stage.structured_metadata {
		values = {
			geoip_country_name       = "",
			geoip_city_name          = "",
			geoip_location_latitude  = "",
			geoip_location_longitude = "",
		}
	}

	stage.static_labels {
		values = {
			project     = "servicehub",
			environment = sys.env("ENVIRONMENT"),
		}
	}
}

// =============================================
// LOGS — container logs via Docker socket with GeoIP
// =============================================
loki.source.docker "container_logs" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.logs.output
	forward_to = [loki.secretfilter.container.receiver]
}

loki.secretfilter "container" {
	drop_on_timeout = true
	label_timed_out = true
	redact_with     = "<REDACTED:$SECRET_NAME>"
	forward_to      = [loki.process.geoip_enrichment.receiver]
}

loki.write "vlogs" {
	endpoint {
		url = "http://obsvcevlogs:9428/insert/loki/api/v1/push"
	}
}
