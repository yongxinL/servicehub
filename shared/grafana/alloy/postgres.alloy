// =============================================
// REMOTE WRITE — VictoriaMetrics
// =============================================
prometheus.remote_write "vm" {
    endpoint {
        url = "http://obsvcevm:8428/api/v1/write"
    }
}

// =============================================
// POSTGRESQL METRICS
// Loaded only when POSTGRES_EXPORTER_ENABLED=true. Credentials arrive
// through runtime environment only.
// =============================================
prometheus.exporter.postgres "primary" {
    data_source_names = [
        "postgresql://" + sys.env("POSTGRES_EXPORTER_USER") + ":" + sys.env("POSTGRES_EXPORTER_PASSWORD") + "@" + sys.env("POSTGRES_EXPORTER_HOST") + ":" + sys.env("POSTGRES_EXPORTER_PORT") + "/" + sys.env("POSTGRES_EXPORTER_DATABASE") + "?sslmode=disable",
    ]
    enabled_collectors = [
        "database",
        "locks",
        "replication_slot",
        "replication",
        "roles",
        "stat_bgwriter",
        "stat_database",
        "stat_progress_vacuum",
        "stat_user_tables",
        "statio_user_tables",
        "wal",
    ]
}

prometheus.scrape "postgres" {
    targets         = prometheus.exporter.postgres.primary.targets
    forward_to      = [prometheus.remote_write.vm.receiver]
    scrape_interval = "30s"
    scrape_timeout  = "15s"
}
