{
  "annotations": {
    "list": []
  },
  "description": "Observability pipeline health. Grafana cannot reliably report its own total failure; OCI Monitoring is the external watchdog.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Alloy and observability-service probes; Runtime verification pending.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "Down"
                },
                "1": {
                  "text": "Ready"
                }
              },
              "type": "value"
            }
          ],
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "up{job=\"alloy\"}",
          "legendFormat": "Alloy self-scrape",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "probe_success{service=~\"victoriametrics|victorialogs|grafana\"}",
          "legendFormat": "{{service}}",
          "refId": "B"
        }
      ],
      "title": "Collector and store readiness",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Alloy remote-write failure counters; Runtime verification pending.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (remote_name, url) (rate(prometheus_remote_storage_samples_failed_total[5m]))",
          "legendFormat": "{{remote_name}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(prometheus_remote_storage_samples_dropped_total[5m]))",
          "legendFormat": "Dropped",
          "refId": "B"
        }
      ],
      "title": "Remote-write health",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Scrape status for configured Alloy jobs; Runtime verification pending.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "Failed"
                },
                "1": {
                  "text": "Up"
                }
              },
              "type": "value"
            }
          ],
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "up{job=~\"obstack|cadvisor|traefik|alloy|internal|public\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "Scrape health",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Filesystem capacity backing observability data; Runtime verification pending.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * (1 - node_filesystem_avail_bytes / node_filesystem_size_bytes)",
          "legendFormat": "{{mountpoint}}",
          "refId": "A"
        }
      ],
      "title": "Storage capacity",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "description": "Observability component logs; Runtime verification pending.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 5,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "{project=\"servicehub\",container_name=~\"servicehub-obsvce(alloy|vm|vlogs|grafana)-1\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Observability logs",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "description": "Recent log ingestion as a time series using a 1-minute range aggregation against VictoriaLogs. Runtime verification pending.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "{project=\"servicehub\"} | stats count() as logs",
          "queryType": "statsRange",
          "refId": "A",
          "step": "1m"
        }
      ],
      "title": "Recent log ingestion",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "datasource",
        "uid": "grafana"
      },
      "description": "Grafana built-in alert list. Reflects configured Grafana alert-rule evaluation state only; notification and watchdog coverage are shown separately.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 6
      },
      "id": 7,
      "options": {
        "viewMode": "list",
        "groupBy": [
          "alertname",
          "grafana_folder",
          "severity"
        ],
        "maxItems": 20,
        "sortOrder": 3,
        "stateFilter": {
          "alerting": true,
          "pending": true,
          "noData": true,
          "normal": false
        }
      },
      "targets": [],
      "title": "Live alert evaluation",
      "type": "alertlist"
    },
    {
      "id": 9,
      "title": "Notification and watchdog coverage",
      "description": "Static operational-capability status. Alert evaluation is operational; delivery and independent host monitoring are owner-dependent follow-up items.",
      "type": "text",
      "options": {
        "mode": "markdown",
        "content": "**Alert evaluation**  Runtime verified\n**Notification delivery**  Not configured\n**External host watchdog**  Not configured\n**OCI APM**  Disabled; not used as the watchdog mechanism"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 6
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "servicehub",
    "adr-010",
    "observability"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "ServiceHub Observability Health",
  "uid": "servicehub-observability-health",
  "version": 1
}
