{
  "annotations": {
    "list": []
  },
  "description": "Application availability, edge requests, resources, and logs filtered by bounded logical_service. Readiness uses min aggregation so a failing required probe correctly marks the service unhealthy.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "One readiness card per bounded logical_service. min aggregation surfaces a failing required probe (Authentik maps server+worker both to logical_service=authentik).",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "Down"
                },
                "1": {
                  "text": "Ready"
                }
              },
              "type": "value"
            }
          ],
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "min by (logical_service) (probe_success{logical_service=~\"^(${service:regex})$\",probe_type=\"readiness\",target_class=\"internal\"})",
          "legendFormat": "{{logical_service}}",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Application readiness",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Traefik request rate and 5xx rate grouped by bounded logical_service. No requests{...} legend: legend uses logical_service label.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (logical_service) (rate(traefik_service_requests_total{logical_service=~\"^(${service:regex})$\"}[5m]))",
          "legendFormat": "{{logical_service}} requests",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (logical_service) (rate(traefik_service_requests_total{logical_service=~\"^(${service:regex})$\",code=~\"5..\"}[5m]))",
          "legendFormat": "{{logical_service}} 5xx",
          "refId": "B"
        }
      ],
      "title": "Requests and errors",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "p50/p95 latency by logical_service from Traefik duration buckets (0.1/0.3/1.2/5.0s). Values may plateau near 5s when requests fall in the +Inf bucket: histogram_quantile cannot interpolate beyond the highest finite bucket. Low-traffic services can show unstable quantiles.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.50, sum by (le, logical_service) (rate(traefik_service_request_duration_seconds_bucket{logical_service=~\"^(${service:regex})$\"}[5m])))",
          "legendFormat": "{{logical_service}} p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.95, sum by (le, logical_service) (rate(traefik_service_request_duration_seconds_bucket{logical_service=~\"^(${service:regex})$\"}[5m])))",
          "legendFormat": "{{logical_service}} p95",
          "refId": "B"
        }
      ],
      "title": "Request latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "cAdvisor CPU rate for containers matching the selected logical_service via bounded compose_service mapping. Range query kept short to avoid stale containers.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{logical_service=~\"^(${service:regex})$\"}[5m])) * 100",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Container CPU",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "cAdvisor memory working set and limit for containers matching the selected logical_service.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (name) (container_memory_working_set_bytes{logical_service=~\"^(${service:regex})$\"})",
          "legendFormat": "{{name}} working set",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (name) (container_spec_memory_limit_bytes{logical_service=~\"^(${service:regex})$\"})",
          "legendFormat": "{{name}} limit",
          "refId": "B"
        }
      ],
      "title": "Container memory",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Authentik-specific task queue metrics. Fixed panel: not governed by the Service selector (this metric is authentik-only; an arrow pattern would be misleading).",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (queue_name) (authentik_tasks_queued)",
          "legendFormat": "{{queue_name}}",
          "refId": "A"
        }
      ],
      "title": "Authentik task queue (Authentik only)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "description": "Application container logs filtered by logical_service. Each selected service retains its own row of logs; All expands to the eight bounded services only.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 7,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "{project=\"servicehub\",logical_service=~\"^(${service:regex})$\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Application logs",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "servicehub",
    "adr-010",
    "applications"
  ],
  "templating": {
    "list": [
      {
        "allValue": "authentik|confluence|forgejo|grafana|ocis|traefik|victoriametrics|victorialogs",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "definition": "label_values(probe_success{probe_type=\"readiness\"}, logical_service)",
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "query": {
          "query": "label_values(probe_success{probe_type=\"readiness\"}, logical_service)",
          "refId": "service-variable"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "ServiceHub Applications",
  "uid": "servicehub-applications",
  "version": 2
}
