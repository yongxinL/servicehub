{
  "annotations": {
    "list": []
  },
  "description": "Docker and container telemetry from Stage 1 cAdvisor collection. Current-state panels use instant queries so historic container incarnations cannot duplicate cards.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Instant query: 1 = running (last seen within 90s), 0 = missing. The bool modifier is required; a bare comparison is a filter and returns elapsed seconds (e.g. 27.4) instead of a state.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "Missing"
                },
                "1": {
                  "text": "Running"
                }
              },
              "type": "value"
            }
          ],
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        },
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (name) ((time() - container_last_seen{name=~\"^(${container:regex})$\"}) < bool 90)",
          "legendFormat": "{{name}}",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Container running",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "cAdvisor CPU usage rate over five minutes.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(container_cpu_usage_seconds_total{name=~\"^(${container:regex})$\"}[5m]) * 100",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "CPU usage",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "cAdvisor memory usage, working set, and configured limit.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "container_memory_usage_bytes{name=~\"^(${container:regex})$\"}",
          "legendFormat": "{{name}} usage",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "container_memory_working_set_bytes{name=~\"^(${container:regex})$\"}",
          "legendFormat": "{{name}} working set",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "container_spec_memory_limit_bytes{name=~\"^(${container:regex})$\"}",
          "legendFormat": "{{name}} limit",
          "refId": "C"
        }
      ],
      "title": "Memory and limits",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "cAdvisor filesystem read/write throughput.",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(container_fs_reads_bytes_total{name=~\"^(${container:regex})$\"}[5m])",
          "legendFormat": "{{name}} read",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(container_fs_writes_bytes_total{name=~\"^(${container:regex})$\"}[5m])",
          "legendFormat": "{{name}} write",
          "refId": "B"
        }
      ],
      "title": "Container disk I/O",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Current container age from container start time. Informational only; color is neutral. A fresh age matters only with restart evidence in the Restart and OOM panel.",
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "id": 7,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (name) (time() - container_start_time_seconds{name=~\"^(${container:regex})$\"})",
          "legendFormat": "{{name}}",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Container age",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Intentional 15-minute historical lookback: restart count (start-time changes) and OOM events, grouped by visible container identity.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (name) (changes(container_start_time_seconds{name=~\"^(${container:regex})$\"}[15m]))",
          "legendFormat": "{{name}} restarts (15m)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (name) (increase(container_oom_events_total{name=~\"^(${container:regex})$\"}[15m]))",
          "legendFormat": "{{name}} OOM (15m)",
          "refId": "B"
        }
      ],
      "title": "Restart and OOM indicators",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "description": "Container log stream filtered by container_name with regex-safe interpolation.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 9,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "displayedFields": ["_time", "container_name", "level", "_msg"]
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "{project=\"servicehub\"} | filter container_name:re(\"^(${container:regex})$\") | fields _msg, level, container_name, logical_service",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Container logs",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "id": 10,
      "panels": [],
      "title": "Runtime Limitations",
      "type": "row"
    },
    {
      "datasource": {
        "type": "grafana",
        "uid": "grafana"
      },
      "description": "Runtime limitation stated honestly; no throttling value is inferred.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "id": 3,
      "options": {
        "content": "### CPU throttling unsupported\n\nPer-container CPU throttling metrics are not exposed by the current cAdvisor/runtime combination. General CPU utilization is in the CPU Usage panel; no throttling value is inferred.",
        "mode": "markdown"
      },
      "targets": [],
      "title": "CPU throttling",
      "type": "text"
    },
    {
      "datasource": {
        "type": "grafana",
        "uid": "grafana"
      },
      "description": "Runtime limitation stated honestly; identity-less root network series is not presented as per-container traffic.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "id": 5,
      "options": {
        "content": "### Per-container network unavailable\n\nThe source exposes only an identity-less root-cgroup network series, so per-container traffic is not shown. It is intentionally not presented as per-container data.",
        "mode": "markdown"
      },
      "targets": [],
      "title": "Container network",
      "type": "text"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["servicehub", "adr-010", "docker"],
  "templating": {
    "list": [
      {
        "allValue": "servicehub-.*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "definition": "label_values(container_last_seen{name=~\"servicehub-.*\"}, name)",
        "includeAll": true,
        "label": "Container",
        "multi": true,
        "name": "container",
        "query": {
          "query": "label_values(container_last_seen{name=~\"servicehub-.*\"}, name)",
          "refId": "container-variable"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "ServiceHub Docker and Containers",
  "uid": "servicehub-docker-containers",
  "version": 2
}
