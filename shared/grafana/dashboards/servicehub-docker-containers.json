      "description": "Last-seen container state; Runtime verification pending.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "Missing"
                },
                "1": {
                  "text": "Seen"
                }
              },
