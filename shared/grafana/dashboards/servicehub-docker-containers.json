      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "(time() - container_last_seen{name=~\"${container:regex}\"}) < 90",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
