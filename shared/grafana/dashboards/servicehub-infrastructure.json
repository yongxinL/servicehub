    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Percentage of swap space currently used: 100 * (SwapTotal - SwapFree) / SwapTotal, kept only when SwapTotal > 0 (PromQL `and` filter). Hosts with swap disabled return no series and render 'Not configured' (noValue), which distinguishes disabled swap from a configured 0%-used swap. Detailed swap series in Memory composition below.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "mappings": [
            {
              "options": {
                "match": "null",
                "result": {
                  "text": "N/A"
                }
              },
              "type": "special"
            }
          ],
          "noValue": "Not configured",
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "rgba(50, 172, 45, 0.97)"
              },
              {
                "color": "rgba(237, 129, 40, 0.89)",
                "value": 25
              },
              {
                "color": "rgba(245, 54, 54, 0.9)",
                "value": 60
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
