    {"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "description": "node_exporter memory. Shows total, available, and swap.", "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}, "id": 2, "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "expr": "node_memory_MemTotal_bytes", "legendFormat": "Total", "refId": "A"}, {"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "expr": "node_memory_MemAvailable_bytes", "legendFormat": "Available", "refId": "B"}, {"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "expr": "node_memory_SwapFree_bytes", "legendFormat": "Swap free", "refId": "C"}], "title": "Memory", "type": "timeseries"},
