    {"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "description": "Pressure-stall information (PSI) counters from node_exporter. Shows CPU, memory, and I/O wait.", "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}, "id": 4, "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "expr": "rate(node_pressure_cpu_waiting_seconds_total[5m])", "legendFormat": "CPU waiting", "refId": "A"}, {"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "expr": "rate(node_pressure_memory_waiting_seconds_total[5m])", "legendFormat": "Memory waiting", "refId": "B"}, {"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "expr": "rate(node_pressure_io_waiting_seconds_total[5m])", "legendFormat": "I/O waiting", "refId": "C"}], "title": "Pressure-stall information", "type": "timeseries"},
    {"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "description": "Filesystem capacity (percent) and read-only state for validated mounts only.", "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}, "id": 5, "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "expr": "100 * (1 - node_filesystem_avail_bytes / node_filesystem_size_bytes)", "legendFormat": "{{mountpoint}}", "refId": "A"}, {"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "expr": "node_filesystem_readonly * 100", "legendFormat": "{{mountpoint}} readonly", "refId": "B"}], "title": "Filesystem capacity", "type": "timeseries"},
    {"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "description": "Filesystem inodes (Stage 1 excludes virtual filesystems).", "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}, "id": 6, "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "expr": "100 * (1 - node_filesystem_files_free / node_filesystem_files)", "legendFormat": "{{mountpoint}}", "refId": "A"}], "title": "Inode utilization", "type": "timeseries"},
    {"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "description": "Disk throughput from node_exporter diskstats.", "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16}, "id": 7, "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "expr": "rate(node_disk_read_bytes_total[5m])", "legendFormat": "{{device}} read", "refId": "A"}, {"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "expr": "rate(node_disk_written_bytes_total[5m])", "legendFormat": "{{device}} written", "refId": "B"}], "title": "Disk I/O", "type": "timeseries"},
    {"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "description": "Network throughput excluding loopback (node_exporter collector).", "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16}, "id": 8, "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "expr": "rate(node_network_receive_bytes_total{device!=\"lo\"}[5m])", "legendFormat": "{{device}} receive", "refId": "A"}, {"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "expr": "rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m])", "legendFormat": "{{device}} transmit", "refId": "B"}], "title": "Network", "type": "timeseries"},
    {"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "description": "Host uptime derived from boot time; rendered as duration.", "fieldConfig": {"defaults": {"unit": "dtdurations", "max": null, "min": 0}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16}, "id": 9, "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "targets": [{"datasource": {"type": "prometheus", "uid": "victoriametrics"}, "expr": "node_time_seconds - node_boot_time_seconds", "legendFormat": "Uptime", "refId": "A", "instant": true}], "title": "Uptime", "type": "stat"}
