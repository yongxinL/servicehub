      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "(100 * (node_memory_SwapTotal_bytes{job=\"obstack\",project=\"servicehub\"} - node_memory_SwapFree_bytes{job=\"obstack\",project=\"servicehub\"}) / clamp_min(node_memory_SwapTotal_bytes{job=\"obstack\",project=\"servicehub\"}, 1)) and (node_memory_SwapTotal_bytes{job=\"obstack\",project=\"servicehub\"} > 0)",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A",
          "step": 240
        }
      ],
