    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Percent of CPU time not idle over 5m, averaged across cores. No alert threshold exists for CPU busy; sustained contention is alarmed via Pressure panel.",
