          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "probe_success{component=\"probe\",probe_type=\"https\",target_class=\"external\"}",
          "legendFormat": "{{service}} success",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
