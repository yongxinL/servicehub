      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (logical_service) (increase(traefik_service_requests_total{code=~\"5..\"}[5m]))",
          "legendFormat": "{{logical_service}}",
          "refId": "A"
        }
      ],
      "title": "Service errors",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Blackbox HTTPS probe and certificate expiry; Runtime verification pending.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
