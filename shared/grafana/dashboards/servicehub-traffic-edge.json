    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "description": "Bounded country-code view from VictoriaLogs; Runtime verified.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 6,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "{project=\"servicehub\",container_name=\"servicehub-routetraefik-1\"} | filter geoip_country_code:re(\"^..$\") | stats by (geoip_country_code) count() as requests | sort by (requests desc) | limit 10",
          "queryType": "stats",
          "refId": "A"
        }
      ],
      "title": "Top 10 Countries by Traffic",
      "type": "bargauge",
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "fields": {
              "mode": "all"
            },
            "pattern": "^requests\\{geoip_country_code=\"([^\"]+)\"\\}$",
            "replacement": "$1",
            "result": "replace"
          }
        }
      ]
    },
