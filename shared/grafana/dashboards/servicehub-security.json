          "expr": "sum by (code) (rate(traefik_service_requests_total{code=~\"401|403|404|429\"}[5m]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ],
      "title": "Traefik 401/403/404/429",
      "type": "timeseries"
    },
    {
