    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Traefik authentication and authorization responses; Runtime verification pending.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (code) (rate(traefik_service_requests_total{code=~\"401|403|404|429\"}[5m]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ],
      "title": "Traefik 401/403/404/429",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "description": "Authentik failure events filtered by logical_service and observed level field values. The previous non-existent logical service filter is removed.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "id": 3,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "{project=\"servicehub\",logical_service=\"authentik\"} | filter level:~\"error|warn\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Authentik failures",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "description": "Forgejo container log events matched by bounded failure keywords in the _msg field. Forgejo logs do not reliably set a level field; runner polling, successful HTTP, and normal startup messages are not classified as failures. Empty result is legitimate.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "id": 4,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "{project=\"servicehub\",logical_service=\"forgejo\"} | filter _msg:~\"(?i)(panic|error|fatal|failed|fail:|failed to)\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Forgejo failures",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "description": "Concise GeoIP country summary; detailed country traffic is in ServiceHub Traffic and Edge. Runtime verified.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "id": 5,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "{project=\"servicehub\",container_name=\"servicehub-routetraefik-1\"} | filter geoip_country_code:re(\"^..$\") | stats by (geoip_country_code) count() as requests | sort by (requests desc) | limit 5",
          "queryType": "stats",
          "refId": "A"
        }
      ],
      "title": "Top 5 Countries",
      "type": "bargauge",
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "fields": {
              "mode": "all"
            },
            "pattern": "^requests\\{geoip_country_code=\"([^\"]+)\"\\}$",
            "replacement": "$1",
            "result": "replace"
          }
        }
      ]
    },
    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
